# skill: theme-glass
# depends: none
# prohibit: none

# 主題：Glassmorphism 現代風格
# 特色：毛玻璃背景、漸層按鈕、柔和陰影、精緻圓角

[style]
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

:root {
  --glass-bg: rgba(255, 255, 255, 0.08);
  --glass-border: rgba(255, 255, 255, 0.12);
  --glass-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
  --accent: #6366f1;
  --accent-hover: #818cf8;
  --danger: #f43f5e;
  --success: #10b981;
  --warning: #f59e0b;
  --text-primary: #f1f5f9;
  --text-secondary: #94a3b8;
  --bg-main: linear-gradient(135deg, #0f0c29 0%, #302b63 50%, #24243e 100%);
  --card-bg: rgba(255, 255, 255, 0.06);
  --border-subtle: rgba(255, 255, 255, 0.08);
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  background: var(--bg-main);
  color: var(--text-primary);
  min-height: 100vh;
  background-attachment: fixed;
}

.warehouse-header {
  background: var(--glass-bg) !important;
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--glass-border) !important;
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.15) !important;
  padding: 20px 32px !important;
}

.header-title { font-size: 22px !important; font-weight: 700 !important; letter-spacing: -0.5px; }

.btn-primary {
  background: linear-gradient(135deg, var(--accent) 0%, #8b5cf6 100%) !important;
  border: none !important;
  border-radius: 10px !important;
  padding: 10px 20px !important;
  font-weight: 600 !important;
  font-size: 14px !important;
  box-shadow: 0 4px 15px rgba(99, 102, 241, 0.4) !important;
  transition: all 0.2s ease !important;
}
.btn-primary:hover {
  transform: translateY(-1px) !important;
  box-shadow: 0 6px 20px rgba(99, 102, 241, 0.5) !important;
  background: linear-gradient(135deg, var(--accent-hover) 0%, #a78bfa 100%) !important;
}

.btn-edit {
  border: 1px solid rgba(255,255,255,0.15) !important;
  background: var(--glass-bg) !important;
  backdrop-filter: blur(10px);
  border-radius: 8px !important;
  color: var(--text-primary) !important;
  transition: all 0.2s ease !important;
}
.btn-edit:hover {
  background: rgba(255,255,255,0.12) !important;
  border-color: var(--accent) !important;
}

.btn-delete {
  border: 1px solid rgba(244, 63, 94, 0.3) !important;
  background: rgba(244, 63, 94, 0.1) !important;
  color: var(--danger) !important;
  border-radius: 8px !important;
  transition: all 0.2s ease !important;
}
.btn-delete:hover {
  background: rgba(244, 63, 94, 0.2) !important;
  border-color: var(--danger) !important;
}

.inventory-table { border-collapse: separate !important; border-spacing: 0 8px !important; }
.inventory-table th {
  background: transparent !important;
  color: var(--text-secondary) !important;
  font-size: 11px !important;
  font-weight: 600 !important;
  text-transform: uppercase !important;
  letter-spacing: 0.8px !important;
  border: none !important;
  padding: 0 16px 12px !important;
}
.inventory-table td {
  background: var(--card-bg) !important;
  border: 1px solid var(--border-subtle) !important;
  border-left: none !important;
  border-right: none !important;
  padding: 16px !important;
  transition: background 0.15s ease !important;
}
.inventory-table tr td:first-child { border-left: 1px solid var(--border-subtle) !important; border-radius: 12px 0 0 12px !important; }
.inventory-table tr td:last-child { border-right: 1px solid var(--border-subtle) !important; border-radius: 0 12px 12px 0 !important; }
.inventory-table tr:hover td { background: rgba(255,255,255,0.1) !important; }

.toolbar {
  background: transparent !important;
  border: none !important;
  padding: 24px 32px !important;
}
.search-box input {
  background: var(--glass-bg) !important;
  backdrop-filter: blur(10px);
  border: 1px solid var(--glass-border) !important;
  border-radius: 10px !important;
  color: var(--text-primary) !important;
  padding: 10px 16px 10px 40px !important;
  font-size: 14px !important;
  transition: all 0.2s ease !important;
}
.search-box input:focus {
  border-color: var(--accent) !important;
  box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2) !important;
  outline: none !important;
}
.search-box input::placeholder { color: var(--text-secondary) !important; }
.filter-group select {
  background: var(--glass-bg) !important;
  backdrop-filter: blur(10px);
  border: 1px solid var(--glass-border) !important;
  border-radius: 10px !important;
  color: var(--text-primary) !important;
  padding: 10px 16px !important;
  font-size: 14px !important;
  cursor: pointer !important;
  transition: all 0.2s ease !important;
}
.filter-group select option { background: #1e1b4b; color: #f1f5f9; }
.filter-group select:focus { border-color: var(--accent) !important; outline: none !important; }
