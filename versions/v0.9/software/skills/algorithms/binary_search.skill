# skill: binary_search
# depends: array-base,comparison
# prohibit: malloc,calloc,realloc,free

// Binary search — O(log n), requires sorted array, returns index or -1
int binary_search(int arr[], int n, int target) {
    int left = 0;
    int right = n - 1;
    while (left <= right) {
        int mid = left + (right - left) / 2;
        if (compare_eq(arr[mid], target)) return mid;
        if (compare_gt(arr[mid], target)) {
            right = mid - 1;
        } else {
            left = mid + 1;
        }
    }
    return -1;
}
