# skill: quick_sort
# depends: array-base,comparison,signal-handler,printf-basic
# prohibit: none

// Quick sort — O(n log n) average, O(n²) worst, not stable
// Uses stack for explicit recursion to stay within static memory
void quick_sort(int arr[], int low, int high) {
    if (low >= high) return;

    int pivot = arr[high];
    int i = low - 1;

    for (int j = low; j < high; j++) {
        if (compare_gt(pivot, arr[j])) {
            i++;
            swap(&arr[i], &arr[j]);
        }
    }
    swap(&arr[i + 1], &arr[high]);

    int pi = i + 1;
    quick_sort(arr, low, pi - 1);
    quick_sort(arr, pi + 1, high);
}
