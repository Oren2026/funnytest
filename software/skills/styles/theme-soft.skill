# skill: theme-soft
# depends: none
# prohibit: none

# 主題：Soft Light 柔和奶油風
# 特色：米白背景、粉色系、極柔和陰影、精緻圓角

[style]
@import url('https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;600&display=swap');

:root {
  --bg: #FAF9F7;
  --card-bg: #FFFFFF;
  --border: #EDE9E3;
  --accent: #E07A5F;
  --accent-hover: #D4624A;
  --danger: #D64045;
  --success: #57A773;
  --warning: #E9B44C;
  --text-primary: #3D3D3D;
  --text-secondary: #8C8C8C;
  --text-muted: #B5B5B5;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: 'Noto Sans TC', sans-serif;
  background: var(--bg);
  color: var(--text-primary);
  min-height: 100vh;
}

.warehouse-header {
  background: var(--card-bg) !important;
  border-bottom: 1px solid var(--border) !important;
  padding: 18px 32px !important;
  box-shadow: 0 2px 12px rgba(0,0,0,0.04) !important;
}
.header-title { font-size: 20px !important; font-weight: 600 !important; color: var(--text-primary) !important; }

.btn-primary {
  background: var(--accent) !important;
  border: none !important;
  border-radius: 20px !important;
  padding: 9px 20px !important;
  font-weight: 500 !important;
  font-size: 14px !important;
  color: #fff !important;
  box-shadow: 0 4px 12px rgba(224, 122, 95, 0.3) !important;
  transition: all 0.2s ease !important;
}
.btn-primary:hover {
  background: var(--accent-hover) !important;
  box-shadow: 0 6px 16px rgba(224, 122, 95, 0.4) !important;
  transform: translateY(-1px) !important;
}

.btn-edit {
  border: 1px solid var(--border) !important;
  background: var(--card-bg) !important;
  color: var(--text-secondary) !important;
  border-radius: 16px !important;
  font-size: 13px !important;
  font-weight: 500 !important;
  transition: all 0.2s ease !important;
  padding: 5px 14px !important;
}
.btn-edit:hover {
  border-color: var(--accent) !important;
  color: var(--accent) !important;
}

.btn-delete {
  border: 1px solid rgba(214, 64, 69, 0.2) !important;
  background: rgba(214, 64, 69, 0.05) !important;
  color: var(--danger) !important;
  border-radius: 16px !important;
  font-size: 13px !important;
  font-weight: 500 !important;
  transition: all 0.2s ease !important;
  padding: 5px 14px !important;
}
.btn-delete:hover {
  background: rgba(214, 64, 69, 0.1) !important;
  border-color: var(--danger) !important;
}

.inventory-table { border-collapse: separate !important; border-spacing: 0 6px !important; }
.inventory-table th {
  background: transparent !important;
  color: var(--text-muted) !important;
  font-size: 11px !important;
  font-weight: 600 !important;
  text-transform: uppercase !important;
  letter-spacing: 0.5px !important;
  border: none !important;
  padding: 0 16px 10px !important;
}
.inventory-table td {
  background: var(--card-bg) !important;
  border: 1px solid var(--border) !important;
  border-left: none !important;
  border-right: none !important;
  padding: 14px 16px !important;
  font-size: 14px !important;
  border-radius: 0 !important;
  transition: all 0.15s ease !important;
}
.inventory-table tr td:first-child { border-left: 1px solid var(--border) !important; border-radius: 12px 0 0 12px !important; }
.inventory-table tr td:last-child { border-right: 1px solid var(--border) !important; border-radius: 0 12px 12px 0 !important; }
.inventory-table tr:hover td { background: #FFF8F5 !important; }

.toolbar {
  background: transparent !important;
  border: none !important;
  padding: 20px 0 !important;
}
.search-box input {
  background: var(--card-bg) !important;
  border: 1px solid var(--border) !important;
  border-radius: 20px !important;
  color: var(--text-primary) !important;
  padding: 10px 18px !important;
  font-size: 14px !important;
  width: 240px !important;
  box-shadow: 0 2px 8px rgba(0,0,0,0.04) !important;
  transition: all 0.2s ease !important;
}
.search-box input:focus {
  border-color: var(--accent) !important;
  box-shadow: 0 0 0 3px rgba(224, 122, 95, 0.1) !important;
  outline: none !important;
}
.search-box input::placeholder { color: var(--text-muted) !important; }
.filter-group select {
  background: var(--card-bg) !important;
  border: 1px solid var(--border) !important;
  border-radius: 20px !important;
  color: var(--text-primary) !important;
  padding: 10px 18px !important;
  font-size: 14px !important;
  box-shadow: 0 2px 8px rgba(0,0,0,0.04) !important;
  cursor: pointer !important;
}
.filter-group select option { background: var(--card-bg); }
.filter-group select:focus { border-color: var(--accent) !important; outline: none !important; }

.badge { padding: 4px 12px !important; border-radius: 20px !important; font-size: 12px !important; font-weight: 500 !important; }
.badge-ok { background: rgba(87,167,115,0.12) !important; color: var(--success) !important; }
.badge-warning { background: rgba(233,180,76,0.15) !important; color: #C49A2E !important; }
.badge-danger { background: rgba(214,64,69,0.1) !important; color: var(--danger) !important; }

.category-tag { padding: 4px 12px !important; border-radius: 20px !important; font-size: 12px !important; font-weight: 500 !important; }
.cat-electronics { background: rgba(93,142,228,0.1) !important; color: #4A7FCC !important; }
.cat-tools { background: rgba(233,180,76,0.15) !important; color: #C49A2E !important; }
.cat-materials { background: rgba(87,167,115,0.12) !important; color: var(--success) !important; }
.cat-packaging { background: rgba(174,137,219,0.12) !important; color: #8B6AC4 !important; }
