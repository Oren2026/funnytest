# skill: stack-static
# depends: array-base
# prohibit: malloc,calloc,realloc,free

// Static stack — array-based, fixed capacity
#define STACK_CAPACITY 128

struct StaticStack {
    int data[STACK_CAPACITY];
    int top;
};

void stack_init(struct StaticStack* s) {
    s->top = -1;
}

int stack_push(struct StaticStack* s, int val) {
    if (s->top >= STACK_CAPACITY - 1) return 0;
    s->data[++s->top] = val;
    return 1;
}

int stack_pop(struct StaticStack* s, int* out) {
    if (s->top < 0) return 0;
    *out = s->data[s->top--];
    return 1;
}

int stack_peek(struct StaticStack* s, int* out) {
    if (s->top < 0) return 0;
    *out = s->data[s->top];
    return 1;
}

int stack_is_empty(struct StaticStack* s) {
    return s->top < 0;
}
