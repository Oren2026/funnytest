# skill: array-base
# depends: none
# prohibit: malloc,calloc,realloc,free

// Array base utilities — read, write, copy
// Array copy — static buffer only
void array_copy(int dest[], const int src[], int n) {
    for (int i = 0; i < n; i++) {
        dest[i] = src[i];
    }
}

// Array fill with value
void array_fill(int arr[], int n, int value) {
    for (int i = 0; i < n; i++) {
        arr[i] = value;
    }
}

// Array reverse — in-place
void array_reverse(int arr[], int n) {
    int left = 0;
    int right = n - 1;
    while (left < right) {
        int tmp = arr[left];
        arr[left] = arr[right];
        arr[right] = tmp;
        left++;
        right--;
    }
}
